# cmake/susfwkConfig.cmake.in
#
@PACKAGE_INIT@

set_and_check(SUSFWK_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/susfwk")
set(SUSFWK_ROOT_DIR "@PACKAGE_CMAKE_INSTALL_PREFIX@")
set(SUSFWK_BIN_DIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set(SUSFWK_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

set(SUSFWK_VERSION @PROJECT_VERSION@)
set(SUSFWK_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(SUSFWK_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(SUSFWK_VERSION_PATCH @PROJECT_VERSION_PATCH@)
set(SUSFWK_CPU_DISPATCH @SUSFWK_CPU_DISPATCH@)

include("${CMAKE_CURRENT_LIST_DIR}/susfwkTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/susfwkHelpers.cmake")

check_required_components(susfwk)
